#!/bin/bash
set -euo pipefail

config_tmp=/etc/squid/squid.conf.norcom.tmp
config_backup=/etc/squid/squid.conf.norcom.bak

cat > "$config_tmp" <<'SQUIDCONF'
http_port 3128
acl SSL_ports port 443
acl Safe_ports port 80 443
acl CONNECT method CONNECT
acl allowed_methods method CONNECT GET HEAD
acl allowed_domains dstdomain ${allowed_domains}

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access deny !allowed_methods
http_access allow allowed_domains
http_access deny all

cache deny all
cache_store_log none
access_log stdio:/var/log/squid/access.log
logfile_rotate 5
SQUIDCONF

if ! squid -k parse -f "$config_tmp"; then
  rm -f "$config_tmp"
  exit 1
fi

cp -p /etc/squid/squid.conf "$config_backup"
install -o root -g root -m 0644 "$config_tmp" /etc/squid/squid.conf
rm -f "$config_tmp"

if ! squid -k reconfigure || ! systemctl is-active --quiet squid; then
  install -o root -g root -m 0644 "$config_backup" /etc/squid/squid.conf
  squid -k reconfigure || true
  exit 1
fi
